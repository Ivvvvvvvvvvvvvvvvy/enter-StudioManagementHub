
-- bookings
create table if not exists bookings (
  id text primary key,
  session_id text not null,
  customer_id text not null,
  status text not null,
  notes text default '',
  created_at text not null
);
alter table bookings enable row level security;
create policy "allow_all_bookings" on bookings for all using (true) with check (true);

-- membership_cards
create table if not exists membership_cards (
  id text primary key,
  customer_id text not null,
  type text not null,
  total_sessions integer,
  used_sessions integer not null default 0,
  price numeric not null,
  expiry text not null,
  purchase_date text not null,
  is_active boolean not null default true
);
alter table membership_cards enable row level security;
create policy "allow_all_cards" on membership_cards for all using (true) with check (true);

