-- Create public bucket for course media uploads
INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
VALUES (
  'course-assets',
  'course-assets',
  true,
  104857600,
  ARRAY['image/jpeg','image/jpg','image/png','image/webp','video/mp4','video/webm','video/quicktime']
)
ON CONFLICT (id) DO NOTHING;

-- Allow public read
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE tablename = 'objects' AND policyname = 'course-assets public read'
  ) THEN
    CREATE POLICY "course-assets public read" ON storage.objects FOR SELECT USING (bucket_id = 'course-assets');
  END IF;
END $$;

-- Allow any authenticated upload
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE tablename = 'objects' AND policyname = 'course-assets upload'
  ) THEN
    CREATE POLICY "course-assets upload" ON storage.objects FOR INSERT WITH CHECK (bucket_id = 'course-assets');
  END IF;
END $$;

-- Allow delete
DO $$ BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE tablename = 'objects' AND policyname = 'course-assets delete'
  ) THEN
    CREATE POLICY "course-assets delete" ON storage.objects FOR DELETE USING (bucket_id = 'course-assets');
  END IF;
END $$;
